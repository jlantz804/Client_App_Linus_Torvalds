<?xml version="1.0" encoding="utf-8" ?>
<!-- Teacher Sign in Joey -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AdaptedPE.TeacherSignInPage"
    BackgroundColor="White">

    <VerticalStackLayout
        Padding="22,25,22,25"
        Spacing="18"
        VerticalOptions="Center">

        <Label
            Text="Teacher Sign in"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="#111111"
            HorizontalTextAlignment="Center"
            Margin="0,12,0,0" />

        <Label
            Text="Prototype access — no account required."
            FontSize="16"
            TextColor="#667085"
            HorizontalTextAlignment="Center" />

        <Button
            x:Name="SignInButton"
            Text="Sign in"
            FontSize="17"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#1464D2"
            CornerRadius="10"
            HeightRequest="52"
            Margin="0,12,0,0"
            Clicked="OnSignInClicked" />

    </VerticalStackLayout>

</ContentPage>
