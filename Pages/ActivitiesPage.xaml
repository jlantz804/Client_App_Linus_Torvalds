<?xml version="1.0" encoding="utf-8" ?>
<!-- Rishi: Activities workspace styled to match the Lesson Plans page. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client_App.ActivitiesPage"
             Title="Activities"
             BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Padding="22,18"
          RowSpacing="18">

        <!-- Same heading style and New button placement as Lesson Plans. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              VerticalOptions="Center">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label Text="TEACHER WORKSPACE"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="#55766A" />
                <Label Text="Activities"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#18352B" />
                <Label x:Name="ActivityCountLabel"
                       Text="Loading activities…"
                       FontSize="14"
                       TextColor="#718078" />
                <Label x:Name="SchoolLabel"
                       IsVisible="False" />
            </VerticalStackLayout>
            <Button x:Name="NewActivityButton"
                    Grid.Column="1"
                    Text="＋  New activity"
                    Clicked="OnAddClicked"
                    IsVisible="False"
                    BackgroundColor="#216A50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    Padding="16,12"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Same search field design as Lesson Plans. -->
        <Grid x:Name="SearchPanel"
              Grid.Row="2"
              IsVisible="False"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">
            <Border BackgroundColor="White"
                    Stroke="#E1E9E4"
                    StrokeThickness="1"
                    Padding="14,2"
                    StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="⌕"
                           FontSize="24"
                           TextColor="#718078"
                           VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Placeholder="Search activities"
                           PlaceholderColor="#9AA7A0"
                           TextColor="#18352B"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="Refresh"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#EAF3ED"
                    TextColor="#216A50"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Padding="12,10" />
        </Grid>

        <Grid Grid.Row="3">

            <!-- Elementary school: choose between the two saved categories. -->
            <VerticalStackLayout x:Name="CategoryPanel"
                                 IsVisible="False"
                                 Spacing="14">
                <Label Text="Choose an activity category"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#18352B" />
                <Label Text="Select a category to view and manage its activities."
                       FontSize="14"
                       TextColor="#718078" />

                <Border BackgroundColor="White"
                        Stroke="#E1E9E4"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Object Control Skills"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#18352B" />
                            <Label Text="Throwing, tossing, kicking, striking, and catching"
                                   FontSize="13"
                                   TextColor="#718078" />
                        </VerticalStackLayout>
                        <Button x:Name="ObjectControlButton"
                                Grid.Column="1"
                                Text="Open"
                                Clicked="OnObjectControlClicked"
                                BackgroundColor="#EAF3ED"
                                TextColor="#216A50"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="14,8"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E1E9E4"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Locomotor Movements"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#18352B" />
                            <Label Text="Running, walking, hopping, jumping, and more"
                                   FontSize="13"
                                   TextColor="#718078" />
                        </VerticalStackLayout>
                        <Button x:Name="LocomotorButton"
                                Grid.Column="1"
                                Text="Open"
                                Clicked="OnLocomotorClicked"
                                BackgroundColor="#EAF3ED"
                                TextColor="#216A50"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="14,8"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- All schools: searchable activity cards using the Lesson Plans style. -->
            <Grid x:Name="ActivityPanel"
                  IsVisible="False"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label x:Name="CategoryTitle"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#18352B" />
                        <Label Text="Activities available in this category"
                               FontSize="13"
                               TextColor="#718078" />
                    </VerticalStackLayout>
                    <Button x:Name="BackToCategoriesButton"
                            Grid.Column="1"
                            Text="‹ Categories"
                            Clicked="OnBackToCategoriesClicked"
                            IsVisible="False"
                            BackgroundColor="#F1F5F2"
                            TextColor="#216A50"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Padding="12,8"
                            VerticalOptions="Center" />
                </Grid>

                <CollectionView Grid.Row="1"
                                x:Name="ActivitiesCollection"
                                ItemsSource="{Binding VisibleActivities}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,48" Spacing="10"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="No activities found"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#18352B"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Try another search or add a new activity."
                                   FontSize="14"
                                   TextColor="#718078"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    Stroke="#E1E9E4"
                                    StrokeThickness="1"
                                    Padding="18"
                                    StrokeShape="RoundRectangle 18">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}"
                                               FontSize="19"
                                               FontAttributes="Bold"
                                               TextColor="#18352B"
                                               LineBreakMode="WordWrap"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="#EAF3ED"
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 10">
                                            <Label Text="ACTIVITY"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#216A50" />
                                        </Border>
                                    </Grid>
                                    <Label Grid.Row="1"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#46574E"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Description}"
                                                         Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Description}"
                                                         Value="">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                        <Label Text="ADAPTED PE LIBRARY"
                                               FontSize="10"
                                               CharacterSpacing="1"
                                               FontAttributes="Bold"
                                               TextColor="#9AA7A0"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="Delete"
                                                Clicked="OnDeleteClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF0ED"
                                                TextColor="#A64232"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                Padding="14,8" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <HorizontalStackLayout Grid.Row="4" Spacing="10" VerticalOptions="Center">
            <ActivityIndicator x:Name="BusySpinner"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#216A50" />
            <Label x:Name="StatusLabel"
                   FontSize="13"
                   TextColor="#718078"
                   LineBreakMode="WordWrap"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Same pop-up editor design as Lesson Plans, for adding activities. -->
        <Grid x:Name="EditorOverlay"
              Grid.RowSpan="5"
              IsVisible="False"
              ZIndex="10"
              BackgroundColor="#660F2118"
              Padding="20">
            <ScrollView VerticalOptions="Center">
                <Border BackgroundColor="White"
                        Stroke="#E1E9E4"
                        StrokeThickness="1"
                        Padding="22"
                        MaximumWidthRequest="520"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="New activity"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#18352B" />
                        <Label Text="Add an activity to the selected school category."
                               FontSize="14"
                               TextColor="#718078" />
                        <Label Text="Category"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#46574E" />
                        <Label x:Name="EditorCategoryLabel"
                               FontSize="14"
                               TextColor="#216A50"
                               FontAttributes="Bold" />
                        <Label Text="Activity name"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#46574E" />
                        <Entry x:Name="ActivityNameEntry"
                               Placeholder="e.g. Balance relay"
                               MaxLength="100"
                               ClearButtonVisibility="WhileEditing" />
                        <Label x:Name="ValidationLabel"
                               IsVisible="False"
                               FontSize="12"
                               TextColor="#A64232" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Text="Cancel"
                                    Clicked="OnCancelEditorClicked"
                                    BackgroundColor="#F1F5F2"
                                    TextColor="#46574E"
                                    CornerRadius="12" />
                            <Button x:Name="SaveActivityButton"
                                    Grid.Column="1"
                                    Text="Save activity"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#216A50"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
