<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Client_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:AdaptedPE"
    Title="Client_App"
    FlyoutBehavior="Disabled">

    <FlyoutItem Title="Teacher Sign In">
        <ShellContent
            Title="Teacher Sign In"
            ContentTemplate="{DataTemplate pages:TeacherSignInPage}"
            Route="TeacherSignInPage" />
    </FlyoutItem>

    <FlyoutItem Title="School Selection">
        <ShellContent
            Title="School Selection"
            ContentTemplate="{DataTemplate pages:SchoolLevelPage}"
            Route="SchoolLevelPage" />
    </FlyoutItem>
</Shell>