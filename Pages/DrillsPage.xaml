<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Client_App.Models"
             x:Class="Client_App.DrillsPage"
             Title="DrillsPage"
             BackgroundColor="#F4F7F5">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="22,18" RowSpacing="18">
        <!--Heading of Drills Page-->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label Text="TEACHER WORKSPACE"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="#55766A" />
                <Label Text="Drills"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#18352B" />
                <!--Drills Count-->
                <Label x:Name="PlanCountLabel"
                       Text="Connecting to Supabase…"
                       FontSize="14"
                       TextColor="#718078" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <!--Button for Adding Drill-->
                <Button x:Name="AddDrillButton"
                        Text="＋  New Drill"
                        Clicked="OnAddClicked"
                        BackgroundColor="#216A50"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Padding="16,12" />
            </VerticalStackLayout>
        </Grid>
        <!--Search Box-->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E1E9E4"
                StrokeThickness="1"
                Padding="14,2"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="⌕" FontSize="24" TextColor="#718078" VerticalOptions="Center" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Placeholder="Search plans, subjects, or grades"
                       PlaceholderColor="#9AA7A0"
                       TextColor="#18352B"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnSearchTextChanged" /> <!--Make Functional-->
            </Grid>
        </Border>
        <!--Binding for all the Drills-->
        <CollectionView x:Name="DrillsCollection"
                        Grid.Row="3"
                        ItemsSource="{Binding Drills}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,48" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="No Drills found"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#18352B"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Create a drill or try another search."
                           FontSize="14"
                           TextColor="#718078"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Drill">
                    <Border BackgroundColor="White"
                            Stroke="#E1E9E4"
                            StrokeThickness="1"
                            Padding="18"
                            StrokeShape="RoundRectangle 18">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="5">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <!--Drill Name-->
                                        <Label Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            TextColor="#18352B" />
                                        <!--Locked-->
                                        <Image Grid.Column="1" HorizontalOptions="End"
                                            Source="unlock.png" HeightRequest="30" WidthRequest="30">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding Locked}" Value="True">
                                                    <Setter Property="Source" Value="lock.png" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Grid>
                                    <!--Activity Name-->
                                    <Label Text="{Binding ActivityName}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#216A50" />
                                    <!--NOT WORKING-->
                                    <Label Text="{Binding SchoolLevel}"
                                           FontSize="12"
                                           TextColor="#718078" />
                                    <!--Description-->
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#216A50" />
                                </VerticalStackLayout>
                            </Grid>
                            <!--Image and Video checkmark or x-->
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Label Text="{Binding ImageMark, StringFormat='Image  ·  {0}'}"
                                    FontSize="13"
                                    TextColor="#718078" />
                                <Label Grid.Column="1"
                                    Text="{Binding VideoMark, StringFormat='Video  ·  {0}'}"
                                    FontSize="13"
                                    TextColor="#718078"
                                    HorizontalTextAlignment="End" />
                            </Grid>
                        <!--Steps Listing-->    
                            <Label Grid.Row="2"
                                   Text="DRILL STEPS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#9AA7A0" />
                            <Label Grid.Row="3"
                                   Text="{Binding StepsText}"
                                   FontSize="14"
                                   TextColor="#46574E"
                                   LineBreakMode="WordWrap" />
                        <!--Created by, Locked, EDIT and DELETE buttons-->
                            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <!--Created By-->
                                <Label Text="{Binding CreatedBy, StringFormat='Created by: {0}'}"
                                        FontSize="13"
                                        TextColor="#718078"
                                        VerticalOptions="End" />
                                <Button Grid.Column="2"
                                        Text="Edit"
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F1F5F2"
                                        TextColor="#216A50"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        Padding="14,8" />
                                <Button Grid.Column="3"
                                        Text="Delete"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FFF0ED"
                                        TextColor="#A64232"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        Padding="14,8" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--Entry of new or editted Drills-->
        <Grid x:Name="EditorOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              ZIndex="10"
              BackgroundColor="#660F2118"
              Padding="10">
            <ScrollView VerticalOptions="Center">
                <Border BackgroundColor="White"
                        Stroke="#E1E9E4"
                        StrokeThickness="1"
                        Padding="26"
                        MaximumWidthRequest="900"
                        HorizontalOptions="Fill"
                        StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="13">
                        <Label x:Name="EditorHeading" Text="New Drill" FontSize="24"
                            FontAttributes="Bold" TextColor="#18352B" />
                        <Label Text="Add the details for this drill." FontSize="14" TextColor="#718078" />

                        <!--Drill Name Entry-->
                        <Label Text="Drill name" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Entry x:Name="NameEntry" Placeholder="e.g. Jump Shot" />

                        <!--Activity Picker-->
                        <Label Text="Activity or skill" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Picker x:Name="ActivityPicker" Title="Choose an activity or skill"
                                ItemsSource="{Binding Activities}"
                                ItemDisplayBinding="{Binding Name, x:DataType=model:ActivityItem}" />

                        <!--Description Entry-->
                        <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Editor x:Name="DescriptionEditor" Placeholder="What is this drill about?"
                                AutoSize="TextChanges" MinimumHeightRequest="70" />

                        <!--Image Entry-->
                        <Label Text="Image URL" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Entry x:Name="ImageEntry" Placeholder="https://…" Keyboard="Url" />

                        <!--Video Entry-->
                        <Label Text="Video URL" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Entry x:Name="VideoEntry" Placeholder="https://…" Keyboard="Url" />

                        <!--Step Label and Add Step-->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Steps" FontSize="12" FontAttributes="Bold"
                                TextColor="#46574E" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="＋ Add step" Clicked="OnAddStep"
                                BackgroundColor="#F1F5F2" TextColor="#216A50"
                                FontAttributes="Bold" CornerRadius="10" Padding="12,6" />
                        </Grid>

                        <!--Binded Steps-->
                        <VerticalStackLayout x:Name="StepsLayout" Spacing="6"
                                            BindableLayout.ItemsSource="{Binding Steps}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="model:StepItem">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Editor Text="{Binding Text}" Placeholder="Describe this step"
                                                AutoSize="TextChanges" />
                                        <Button Grid.Column="1" Text="✕" Clicked="OnRemoveStep"
                                                BackgroundColor="#FFF0ED" TextColor="#A64232"
                                                CornerRadius="10" VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!--Lock Switch-->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Lock this Drill" FontSize="12"
                                FontAttributes="Bold" TextColor="#46574E" VerticalOptions="Center" />
                            <Switch x:Name="LockedSwitch" Grid.Column="1" />
                        </Grid>

                        <!--Cancel or Save Drill-->
                        <Label x:Name="ValidationLabel" IsVisible="False" FontSize="12" TextColor="#A64232" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Text="Cancel" Clicked="OnCancelEditorClicked"
                                    BackgroundColor="#F1F5F2" TextColor="#46574E" CornerRadius="12" />
                            <Button Grid.Column="1" Text="Save drill" Clicked="OnSaveClicked"
                                    BackgroundColor="#216A50" TextColor="White"
                                    FontAttributes="Bold" CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>