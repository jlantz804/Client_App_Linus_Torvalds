<?xml version="1.0" encoding="utf-8" ?>
<!--EquipmentModificationsPage Alex Martinez! -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client_App.EquipmentModificationsPage"
             Title="EquipmentModificationsPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,20"
            Spacing="10"
            HorizontalOptions="Center">
            <Label Text="Activity" />
            <Picker
                x:Name="ActivityPicker"
                Title="Choose an activity"
                ItemsSource="{Binding Activities}"
                ItemDisplayBinding="{Binding Name}" />
            <Label Text="Name"/>
            <Entry x:Name="NameEntry"
                    Placeholder="Modification Name"/>

            <Label Text="Image URL"/>
                <Entry x:Name="ImageEntry"
                        Placeholder="Equipment Image"/>
            <Label Text="Description"/>
                <Entry x:Name="DescriptionEntry"
                    Placeholder="Description of modification"/>
            <Label Text="ModificationSteps"/>
            <Entry x:Name="ModificationStepsEntry"
                    Placeholder="Modification Steps"/>
            <Button
                x:Name="SaveButton"
                Text="Save"
                Clicked="OnSaveClicked"
                BackgroundColor="#FF158DDD"
                TextColor="Black"/>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>