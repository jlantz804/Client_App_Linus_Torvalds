<?xml version="1.0" encoding="utf-8" ?>
<!---Alex Martinez Equipment modifications-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Client_App.Models"
             x:Class="Client_App.EquipmentModificationsPage"
             Title="Equipment Modifications"
             BackgroundColor="#F4F7F5">

    <ContentPage.Resources>
        <ControlTemplate x:Key="EditorToggleTemplate">
            <ContentPresenter InputTransparent="True" />
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="22,18" RowSpacing="18">

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              VerticalOptions="Center">
            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label Text="TEACHER WORKSPACE"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="#55766A" />
                <Label Text="Equipment Modifications"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#18352B" />
            </VerticalStackLayout>

            <RadioButton x:Name="OpenEditorToggle"
                         Grid.Column="1"
                         GroupName="EquipmentModificationEditor"
                         ControlTemplate="{StaticResource EditorToggleTemplate}"
                         SemanticProperties.Description="New equipment modification"
                         VerticalOptions="Center"
                         CheckedChanged="OnEditorCheckedChanged">
                <RadioButton.Content>
                    <Border BackgroundColor="#216A50"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="16,12">
                        <Label Text="＋  New"
                               TextColor="White"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                    </Border>
                </RadioButton.Content>
            </RadioButton>
        </Grid>

        <CollectionView x:Name="ModificationsCollection"
                        Grid.Row="3"
                        EmptyView="No equipment modifications found.">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:EquipmentModification">
                    <Border BackgroundColor="White"
                            Stroke="#E1E9E4"
                            Padding="18"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#18352B" />
                            <Label Text="{Binding Description}" TextColor="#46574E" />
                            <Label Text="{Binding Steps}" TextColor="#46574E" />

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <Button Text="Edit"
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F1F5F2"
                                        TextColor="#216A50"
                                        CornerRadius="10" />
                                <Button Text="Delete"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FFF0ED"
                                        TextColor="#A64232"
                                        CornerRadius="10" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="EditorOverlay"
              Grid.RowSpan="4"
              IsVisible="{Binding IsChecked, Source={x:Reference OpenEditorToggle}}"
              ZIndex="10"
              BackgroundColor="#660F2118"
              Padding="20">
            <ScrollView VerticalOptions="Center">
                <Border BackgroundColor="White"
                        Stroke="#E1E9E4"
                        StrokeThickness="1"
                        Padding="22"
                        MaximumWidthRequest="520"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Equipment modification"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#18352B"
                               x:Name="EditorHeading" />

                        <Label Text="Activity" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Picker x:Name="ActivityPicker"
                                Title="Choose an activity"
                                ItemsSource="{Binding Activities}"
                                ItemDisplayBinding="{Binding Name}"
                                TextColor="#18352B"
                                TitleColor="#718078" />

                        <Label Text="Modification name" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Entry x:Name="NameEntry"
                               Placeholder="e.g. Larger foam ball"
                               TextColor="#18352B"
                               PlaceholderColor="#718078" />

                        <Label Text="Image URL" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Entry x:Name="ImageEntry"
                               Placeholder="https://"
                               Keyboard="Url"
                               TextColor="#18352B"
                               PlaceholderColor="#718078" />

                        <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Editor x:Name="DescriptionEntry"
                                Placeholder="Describe the equipment modification."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="60"
                                TextColor="#18352B"
                                PlaceholderColor="#718078" />

                        <Label Text="Modification steps" FontSize="12" FontAttributes="Bold" TextColor="#46574E" />
                        <Editor x:Name="ModificationStepsEntry"
                                Placeholder="How should the equipment be adapted?"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="90"
                                TextColor="#18352B"
                                PlaceholderColor="#718078" />

                        <Button x:Name="ClearButton"
                                Text="Clear all entries"
                                Clicked="OnClearClicked"
                                HorizontalOptions="Start"
                                BackgroundColor="#F1F5F2"
                                TextColor="#46574E"
                                CornerRadius="12" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <RadioButton GroupName="EquipmentModificationEditor"
                                         ControlTemplate="{StaticResource EditorToggleTemplate}"
                                         SemanticProperties.Description="Close editor">
                                <RadioButton.Content>
                                    <Border BackgroundColor="#F1F5F2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,10">
                                        <Label Text="Close"
                                               TextColor="#46574E"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </RadioButton.Content>
                            </RadioButton>

                            <Button x:Name="SaveButton"
                                    Grid.Column="1"
                                    Text="Save modification"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="#216A50"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>