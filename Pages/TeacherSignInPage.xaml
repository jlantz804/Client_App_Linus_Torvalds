<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AdaptedPE.TeacherSignInPage"
    BackgroundColor="White">

    <Grid>
        <VerticalStackLayout
            Padding="22,25,22,25"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="Teacher Sign in"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111111"
                HorizontalTextAlignment="Center"
                Margin="0,12,0,0" />

            <Label
                Text="Sign in to continue to your teacher workspace."
                FontSize="16"
                TextColor="#667085"
                HorizontalTextAlignment="Center" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email"
                ClearButtonVisibility="WhileEditing" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True" />

            <Label
                x:Name="SignInMessageLabel"
                IsVisible="False"
                FontSize="13"
                TextColor="#A64232" />

            <Button
                x:Name="SignInButton"
                Text="Sign in"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#1464D2"
                CornerRadius="10"
                HeightRequest="52"
                Margin="0,12,0,0"
                Clicked="OnSignInClicked" />

            <Button
                Text="Create account"
                FontSize="15"
                TextColor="#1464D2"
                BackgroundColor="Transparent"
                Clicked="OnCreateAccountClicked" />

        </VerticalStackLayout>

        <Grid
            x:Name="CreateAccountOverlay"
            IsVisible="False"
            ZIndex="10"
            BackgroundColor="#660F2118"
            Padding="22">
            <ScrollView VerticalOptions="Center">
                <Border
                    BackgroundColor="White"
                    Stroke="#E1E9E4"
                    StrokeThickness="1"
                    Padding="24"
                    MaximumWidthRequest="520"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="14">
                        <Label
                            Text="Create account"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#18352B" />
                        <Label
                            Text="Create a teacher account to access your workspace."
                            FontSize="14"
                            TextColor="#718078" />
                        <Entry
                            x:Name="CreateNameEntry"
                            Placeholder="Name"
                            ClearButtonVisibility="WhileEditing" />
                        <Entry
                            x:Name="CreateEmailEntry"
                            Placeholder="Email"
                            Keyboard="Email"
                            ClearButtonVisibility="WhileEditing" />
                        <Entry
                            x:Name="CreatePasswordEntry"
                            Placeholder="Password"
                            IsPassword="True" />
                        <Label
                            x:Name="CreateAccountMessageLabel"
                            IsVisible="False"
                            FontSize="13"
                            TextColor="#A64232" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Text="Cancel"
                                Clicked="OnCancelCreateAccountClicked"
                                BackgroundColor="#F1F5F2"
                                TextColor="#46574E"
                                CornerRadius="12" />
                            <Button
                                Grid.Column="1"
                                x:Name="CreateAccountSubmitButton"
                                Text="Create account"
                                Clicked="OnSubmitCreateAccountClicked"
                                BackgroundColor="#216A50"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
